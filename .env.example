# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
OPS_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
OPS_TOOLS_TOKEN=
N8N_WEBHOOK_TOKEN=
APPROVER_USER=approver
APPROVER_PASSWORD=

# Optional integrations (leave empty for the local demo; patches go to ./outbox instead of PRs).
# docker compose does not strip inline comments, so keep comments on their own lines.
SLACK_WEBHOOK_URL=
# fine-grained token: contents + pull requests on GITHUB_REPO only
GITHUB_TOKEN=
# owner/name of the repo holding pipeline configs
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_CONFIG_ROOT=pipelines
SPARK_HISTORY_SERVER_URL=
SPARK_EVENT_LOG_HOST_DIR=./demo/spark-events
N8N_PUBLIC_URL=http://localhost:5678/
N8N_WORKERS=2
