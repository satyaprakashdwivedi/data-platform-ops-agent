    "Start run": {
      "main": [
        [
          {
            "node": "Rank jobs by waste (deterministic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rank jobs by waste (deterministic)": {
      "main": [
        [
          {
            "node": "Write the review (agent)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the review (agent)": {
