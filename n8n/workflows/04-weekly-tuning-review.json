{
  "id": "opsWeeklyReview1",
  "name": "Weekly Spark tuning review",
  "active": true,
  "nodes": [
    {
      "id": "882a8194-bf02-563f-9a51-1b0042423fad",
      "name": "Mondays 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "3044931f-0147-5160-817c-eecf989a853a",
      "name": "Run now",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "run-weekly-review",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "0308e237-d0a9-5ec7-942f-96bc78e9c02d",
      "credentials": {
        "httpHeaderAuth": {
          "id": "opsWebhookToken1",
          "name": "Webhook token"
        }
      }
    },
    {
      "id": "5eb7da35-658f-5379-99ef-e6422700fabc",
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_TOOLS_URL }}/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": false,
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"workflow\": \"weekly-tuning-review\", \"subject\": \"all jobs\", \"n8n_execution_id\": {{ JSON.stringify($execution.id) }} }"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBearerAuth": {
          "id": "opsToolsBearer01",
          "name": "Ops tools token"
        }
      }
    },
    {
      "id": "490fffb3-d2b9-5be4-a4fd-932937cdca60",
      "name": "Rank jobs by waste (deterministic)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_TOOLS_URL }}/spark/review",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "options": {
          "timeout": 120000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Run-Id",
              "value": "={{ $('Start run').item.json.run_id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBearerAuth": {
          "id": "opsToolsBearer01",
          "name": "Ops tools token"
        }
      }
    },
    {
      "id": "c5d52138-3596-5d2d-bfea-362d7bb96e27",
      "name": "Write the review (agent)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Task: weekly_review\nRun id (pass it to every tool call): {{ $('Start run').item.json.run_id }}\n\n<review>\n{{ JSON.stringify($json) }}\n</review>",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "You write the weekly Spark tuning review for the data platform team, posted to Slack.\nThe analyzer has ranked recent jobs by idle core-hours (cores paid for but not running tasks).\n\nWrite at most 12 short lines in Slack markdown:\n- one line with the total idle core-hours and the number of jobs reviewed\n- the top 3 jobs: what is wrong in plain words and the single most valuable change\n- one line on anything that needs a human decision (failures, heap OOMs)\nYou may call analyze_spark_job or get_pipeline_config for detail. Use only numbers from tool output.",
          "maxIterations": 10
        }
      }
    },
    {
      "id": "136d5eee-8bc3-566a-9974-7e3d40392442",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        600,
        320
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.ANTHROPIC_MODEL || 'claude-sonnet-5-5' }}"
        },
        "options": {
          "maxTokensToSample": 4096,
          "temperature": 0
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "opsAnthropic0001",
          "name": "Anthropic"
        }
      }
    },
    {
      "id": "862ce23e-6634-585e-a42b-d9fb19341beb",
      "name": "Ops tools",
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1.4,
      "position": [
        760,
        320
      ],
      "parameters": {
        "endpointUrl": "={{ $env.OPS_TOOLS_URL }}/mcp",
        "serverTransport": "httpStreamable",
        "authentication": "bearerAuth",
        "include": "selected",
        "includeTools": [
          "analyze_spark_job",
          "get_pipeline_config"
        ],
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "opsToolsBearer01",
          "name": "Ops tools token"
        }
      }
    },
    {
      "id": "f0b480b0-5b95-54b2-aaba-273f53ff7f29",
      "name": "Post review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1040,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_TOOLS_URL }}/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "options": {
          "timeout": 120000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Run-Id",
              "value": "={{ $('Start run').item.json.run_id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"title\": \"Weekly Spark tuning review\", \"body\": {{ JSON.stringify($json.output) }} }"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBearerAuth": {
          "id": "opsToolsBearer01",
          "name": "Ops tools token"
        }
      }
    },
    {
      "id": "84aabbfb-7b5a-5013-a14e-feb45385d3c7",
      "name": "Finish run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1280,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_TOOLS_URL }}/runs/{{ $('Start run').item.json.run_id }}/finish?status=completed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": false,
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBearerAuth": {
          "id": "opsToolsBearer01",
          "name": "Ops tools token"
        }
      }
    }
  ],
  "connections": {
    "Claude": {
      "ai_languageModel": [
        [
          {
            "node": "Write the review (agent)",
