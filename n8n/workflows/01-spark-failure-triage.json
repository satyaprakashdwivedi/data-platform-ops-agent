    {
      "id": "3a26fa23-2b20-5443-9ef0-68d996f5cfaa",
      "name": "Output schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        920,
        220
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"diagnosis\",\n    \"root_cause\",\n    \"spark_conf\",\n    \"rationale\",\n    \"confidence\"\n  ],\n  \"properties\": {\n    \"diagnosis\": {\n      \"type\": \"string\",\n      \"description\": \"one sentence for the approver\"\n    },\n    \"root_cause\": {\n      \"type\": \"string\"\n    },\n    \"spark_conf\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"keys and exact values from the analyzer's recommendations\"\n    },\n    \"rationale\": {\n      \"type\": \"string\",\n      \"description\": \"evidence: stage, metric or log line\"\n    },\n    \"risks\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  }\n}"
      }
    },
