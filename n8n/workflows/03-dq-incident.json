    {
      "id": "859c8747-836b-5af4-a784-dafed5c56020",
      "name": "Output schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        680,
        220
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"classification\",\n    \"action\",\n    \"summary\",\n    \"rationale\",\n    \"confidence\"\n  ],\n  \"properties\": {\n    \"classification\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"upstream_schema_change\",\n        \"data_defect\",\n        \"rule_too_strict\",\n        \"transient\"\n      ]\n    },\n    \"action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"monitor\",\n        \"open_incident\",\n        \"pause_downstream\",\n        \"adjust_rule\"\n      ]\n    },\n    \"rule_change\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"max_failed_pct\": {\n          \"type\": \"number\"\n        }\n      },\n      \"description\": \"only for adjust_rule\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"rationale\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  }\n}"
      }
    },
